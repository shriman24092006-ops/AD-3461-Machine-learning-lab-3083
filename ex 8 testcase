import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.neighbors import KNeighborsClassifier
from sklearn import metrics

data = {
    'StudyHours': [1, 2, 3, 4, 5, 6, 7, 8, 2, 9],
    'Attendance': [50, 60, 65, 70, 80, 85, 90, 95, 55, 98],
    'PreviousMarks': [40, 45, 50, 55, 65, 70, 75, 85, 48, 90],
    'Result': ['Fail', 'Fail', 'Fail', 'Pass', 'Pass', 'Pass', 'Pass', 'Pass', 'Fail', 'Pass']
}

df = pd.DataFrame(data)

X = df[['StudyHours', 'Attendance', 'PreviousMarks']]
y = df['Result']

X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=1)

knn = KNeighborsClassifier(n_neighbors=3)
knn.fit(X_train, y_train)

y_pred = knn.predict(X_test)

print("Confusion Matrix:\n", metrics.confusion_matrix(y_test, y_pred))
print("\nClassification Report:\n", metrics.classification_report(y_test, y_pred))
print("\nAccuracy:", metrics.accuracy_score(y_test, y_pred))

new_student = np.array([[5, 75, 60]])
prediction = knn.predict(new_student)

print("\nPrediction for New Student:", prediction[0])
